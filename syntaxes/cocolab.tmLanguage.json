{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Cocolab Script",
    "scopeName": "source.cocolab",
    "patterns": [
        {
            "include": "#comment"
        },
        {
            "include": "#session_separator"
        },
        {
            "include": "#expectation"
        },
        {
            "include": "#access_control"
        },
        {
            "include": "#commands"
        },
        {
            "include": "#clauses"
        },
        {
            "include": "#state_path"
        },
        {
            "include": "#participant_access"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#strings"
        }
    ],
    "repository": {
        "comment": {
            "patterns": [
                {
                    "comment": "Line comment",
                    "name": "comment.line.number-sign.cocolab",
                    "match": "#.*$"
                }
            ]
        },
        "session_separator": {
            "patterns": [
                {
                    "comment": "=== session === restarts the REPL, keeping persisted state",
                    "name": "keyword.control.session.cocolab",
                    "match": "^\\s*===.*===\\s*$"
                }
            ]
        },
        "expectation": {
            "patterns": [
                {
                    "comment": "Negative expectation: output must NOT contain this text",
                    "match": "^\\s*(!>)(.*)$",
                    "captures": {
                        "1": {
                            "name": "keyword.operator.expectation.negative.cocolab"
                        },
                        "2": {
                            "name": "string.unquoted.expectation.cocolab"
                        }
                    }
                },
                {
                    "comment": "Expectation: output must contain this text",
                    "match": "^\\s*(>)(.*)$",
                    "captures": {
                        "1": {
                            "name": "keyword.operator.expectation.cocolab"
                        },
                        "2": {
                            "name": "string.unquoted.expectation.cocolab"
                        }
                    }
                }
            ]
        },
        "access_control": {
            "patterns": [
                {
                    "comment": "grant / wipe / get storage_mutate — PISA 0.8.0 access control",
                    "match": "^\\s*(grant|wipe|get)\\s+(storage_mutate)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cocolab"
                        },
                        "2": {
                            "name": "support.type.resource.cocolab"
                        }
                    }
                },
                {
                    "comment": "callers(...) / origins(...) constraint sets",
                    "match": "\\b(callers|origins)\\b\\s*(\\()([^)]*)(\\))",
                    "captures": {
                        "1": {
                            "name": "support.function.cocolab"
                        },
                        "2": {
                            "name": "punctuation.other.bracket.round.cocolab"
                        },
                        "3": {
                            "name": "variable.parameter.cocolab"
                        },
                        "4": {
                            "name": "punctuation.other.bracket.round.cocolab"
                        }
                    }
                },
                {
                    "comment": "`any` opens a constraint to everyone — note it is `any`, not `all`",
                    "name": "constant.language.cocolab",
                    "match": "\\bany\\b"
                }
            ]
        },
        "commands": {
            "patterns": [
                {
                    "comment": "REPL commands, only meaningful at the start of a line",
                    "match": "^\\s*(compile|register|deploy|enlist|invoke|create|observe|set|get|wipe|storagekey|docencode|docdecode|errdecode|logics|engines|users|exit)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cocolab"
                        }
                    }
                }
            ]
        },
        "clauses": {
            "patterns": [
                {
                    "comment": "Clause keywords that modify a command",
                    "name": "keyword.other.cocolab",
                    "match": "\\b(from|as|with|to|through|of|on|events|manifest|coco)\\b"
                },
                {
                    "comment": "Lab defaults",
                    "name": "support.variable.cocolab",
                    "match": "\\bdefault\\.(sender|basefuel|url|env)\\b"
                }
            ]
        },
        "state_path": {
            "patterns": [
                {
                    "comment": "Logic.field / Logic.Actor.field paths",
                    "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\.(Logic|Sender)\\.([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "entity.name.type.logic.cocolab"
                        },
                        "2": {
                            "name": "support.variable.cocolab"
                        },
                        "3": {
                            "name": "variable.other.member.cocolab"
                        }
                    }
                },
                {
                    "comment": "Endpoint call: Logic.Endpoint(",
                    "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\.([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
                    "captures": {
                        "1": {
                            "name": "entity.name.type.logic.cocolab"
                        },
                        "2": {
                            "name": "entity.name.function.cocolab"
                        }
                    }
                },
                {
                    "comment": "Named argument",
                    "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
                    "captures": {
                        "1": {
                            "name": "variable.parameter.cocolab"
                        },
                        "2": {
                            "name": "punctuation.separator.cocolab"
                        }
                    }
                }
            ]
        },
        "participant_access": {
            "patterns": [
                {
                    "comment": "Participant access level: alice/write, bob/read",
                    "match": "(/)(read|write|none)\\b",
                    "captures": {
                        "1": {
                            "name": "punctuation.separator.cocolab"
                        },
                        "2": {
                            "name": "storage.modifier.cocolab"
                        }
                    }
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.cocolab",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "name": "constant.numeric.cocolab",
                    "match": "\\b((0x[0-9a-fA-F]+)|([0-9]+))\\b"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.cocolab",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.cocolab",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        }
    }
}
