{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "watch",
			"dependsOn": ["bundle: watch", "typecheck: watch"],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "bundle: watch",
			"type": "npm",
			"script": "watch",
			"isBackground": true,
			"presentation": {
				"group": "watch",
				"panel": "dedicated",
				"reveal": "never"
			},
			"problemMatcher": {
				"owner": "esbuild",
				"fileLocation": "absolute",
				"pattern": {
					"regexp": "^✘ \\[ERROR\\] (.+)$",
					"message": 1
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^\\[watch\\] build started$",
					"endsPattern": "^\\[watch\\] build finished$"
				}
			}
		},
		{
			"label": "typecheck: watch",
			"type": "npm",
			"script": "typecheck:watch",
			"isBackground": true,
			"presentation": {
				"group": "watch",
				"panel": "dedicated",
				"reveal": "never"
			},
			"problemMatcher": "$tsc-watch"
		}
	]
}
