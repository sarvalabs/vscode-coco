{
	// Type checking only — esbuild produces what actually ships (see esbuild.mjs).
	// Both halves target the Node runtime VS Code embeds.
	"compilerOptions": {
		"module": "node16",
		"moduleResolution": "node16",
		"target": "es2022",
		"lib": ["es2022"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"sourceMap": true
	},
	"include": ["client/src", "server/src"],
	"exclude": ["node_modules", "dist"]
}
