// Everything Cocolang 0.9.2 / PISA 0.8.0 supports, in its correct form.
// This file compiles cleanly with `coco compile`, so the language server must
// report no diagnostics for it.

coco NewFeatures

class Person:
    field name String
    field age U64

class Wrapper:
    field person Person
    field tags []String

class Profile:
    field name String
    field tags Map[String]U64

state logic:
    name String
    config String
    scores Map[String]U64
    profile Profile

state actor:
    tag String
    registered Bool
    balance U64

interface Remote:
    state logic:
        supply U256
    endpoint:
        dynamic Credit(to Identifier, amount U64) -> (balance U64)
        static Supply() -> (supply U256)
    asset:
        Mint(amount U256)

// --- field-name shorthand (stuttering removed) ---------------------------

endpoint pure Make(n String, a U64) -> (p Person):
    memory name = n
    memory age = a
    p = Person{name, age}

endpoint pure Mixed(n String, a U64) -> (p Person):
    memory name = n
    p = Person{name, age: a}

endpoint pure Nested(n String, a U64) -> (w Wrapper):
    memory name = n
    memory age = a
    memory person = Person{name, age}
    memory tags = []String{"vip"}
    w = Wrapper{person, tags}

endpoint pure InLoop(n U64) -> (out []Person):
    memory list []Person
    for age in range(n):
        memory name = f"p{age}"
        append(list, Person{name, age})
    out = list

// --- payer clause --------------------------------------------------------

endpoint deploy Init(name String) -> (added U64, removed U64):
    mutate name -> NewFeatures.Logic.name payer Logic
    added, removed = Environment.StorageResult(account_id: Identifier(NewFeatures), payer_id: Identifier(NewFeatures))

endpoint dynamic SetConfig(cfg String, sponsor Identifier):
    mutate cfg -> NewFeatures.Logic.config payer Actor(sponsor)

endpoint dynamic SetName(n String):
    mutate n -> NewFeatures.Logic.name payer Sender

endpoint dynamic Grow(suffix String):
    mutate v <- NewFeatures.Logic.name payer Logic:
        v += suffix

// --- actor methods -------------------------------------------------------

endpoint pure IsParticipant(participant Identifier) -> (exists Bool):
    exists = Actor(participant).Exists()

endpoint pure SenderSigned() -> (signed Bool):
    signed = Actor(Sender).HasSigned()

endpoint pure Claim(code String) -> (proof Bytes):
    proof = Actor(Sender).Param(name: code)

endpoint pure CheckSigned(participant Identifier) -> (signed Bool):
    if !Actor(participant).Exists():
        throw "not a participant of this interaction"
    signed = Actor(participant).HasSigned()

// --- environment ---------------------------------------------------------

// What used to be an `enlist` endpoint: dynamic, and guarded, because unlike
// enlist it can be called again.
endpoint dynamic Register(tag String) -> (added U64, removed U64):
    mutate done <- NewFeatures.Sender.registered:
        if done:
            throw "already registered"
        done = true
    mutate tag -> NewFeatures.Sender.tag
    added, removed = Environment.StorageResult(account_id: Sender, payer_id: Sender)

endpoint pure Now() -> (ts U64):
    ts = Environment.Timestamp()

// The multi-line call with a trailing comma is how the reference docs write
// StorageResult, so the server must not read the comma as a third argument.
endpoint pure Cost(who Identifier) -> (added U64, removed U64):
    added, removed = Environment.StorageResult(
        account_id: who,
        payer_id: who,
    )

// Argument names are optional where the argument has none of its own — a
// keyword, a cast or a literal — and a bare variable is fine when it is
// already called what the parameter is.
endpoint pure CostUnlabelled(account_id Identifier) -> (added U64, removed U64):
    added, removed = Environment.StorageResult(Sender, Sender)
    added, removed = Environment.StorageResult(Identifier(NewFeatures), payer_id: Sender)
    added, removed = Environment.StorageResult(account_id, Sender)

endpoint pure Fuel() -> (capacity U64, available U64):
    capacity = Environment.EffortCapacity()
    available = Environment.EffortAvailable()

endpoint pure Hash(data Bytes) -> (digest U256):
    digest = Builtins.Sha256(data)

// --- state qualifiers ----------------------------------------------------

// Reads only -> static, and it must be written out; omitting it means pure.
endpoint static Balance(account Identifier) -> (balance U64):
    observe balance <- NewFeatures.Actor(account).balance

// Writes another actor's state -> dynamic (and needs a storage_mutate grant
// from `to` at run time; the compiler does not check that).
endpoint dynamic Credit(to Identifier, amount U64) -> (balance U64):
    mutate b <- NewFeatures.Actor(to).balance:
        b += amount
        balance = b

// Requirement propagates out of a called function.
function static ReadName() -> (name String):
    observe name <- NewFeatures.Logic.name

endpoint static NameViaFunction() -> (name String):
    name = (name) <- ReadName()

// A dynamic interface endpoint makes the caller dynamic.
endpoint dynamic CreditVia(remote Identifier, to Identifier, amount U64) -> (balance U64):
    memory r = Remote(remote)
    balance = r.Credit(to: to, amount: amount)

// A static interface endpoint only makes the caller static.
endpoint static SupplyVia(remote Identifier) -> (supply U256):
    memory r = Remote(remote)
    supply = (supply) <- r.Supply()

// An interface asset operation always makes the caller dynamic.
endpoint dynamic MintVia(remote Identifier, amount U256):
    memory r = Remote(remote)
    r.Mint(amount: amount)

// --- grouped constants (0.9.2) -------------------------------------------

const:
    DEFAULT_TAG String = "member"
    MAX_TAGS U64 = 8
    FLOOR I64 = -5
    OPEN Bool = true

pub const:
    VERSION U64 = 2

const LIMIT U64 = 100

endpoint pure Limits() -> (tag String, total U64, floor I64, open Bool):
    tag = DEFAULT_TAG
    total = MAX_TAGS + VERSION + LIMIT
    floor = FLOOR
    open = OPEN

// --- named outputs (0.9.2) -----------------------------------------------

// The `(names) <- ` capture works on Environment, Invocation and Builtins
// calls; the names must be the ones each output is declared with.
endpoint pure Stamp() -> (ts U64, who Identifier):
    ts = (timestamp) <- Environment.Timestamp()
    memory c = (caller) <- Invocation.Caller()
    who = c

endpoint pure CaptureStorage() -> (a U64, r U64):
    a, r = (added, removed) <- Environment.StorageResult(Identifier(NewFeatures), Sender)

// Only one output wanted: capture both names, discard on the left.
endpoint pure AddedOnly() -> (added U64):
    added, _ = (added, removed) <- Environment.StorageResult(Identifier(NewFeatures), Sender)

endpoint pure Verify(data Bytes, signature Bytes, pubkey Bytes) -> (valid Bool, digest U256):
    valid = (ok) <- Builtins.Sigverify(data, signature, pubkey)
    digest = (hash) <- Builtins.Keccak(data)

// --- maps disperse into storage again (0.9.2) ----------------------------

// Dispersing a map merges it into the stored one; it never clears a key.
endpoint dynamic AddScores(extra Map[String]U64):
    mutate scores <- NewFeatures.Logic.scores:
        disperse scores <- extra

endpoint dynamic SeedScores():
    mutate scores <- NewFeatures.Logic.scores:
        disperse Map[String]U64{"a": 1, "b": 2} -> scores

// A class holding a map disperses too: scalar fields are replaced, the map merges.
endpoint dynamic SetProfile(p Profile):
    mutate stored <- NewFeatures.Logic.profile:
        disperse stored <- p

// A stored map is still read element by element — gathering one whole is not
// allowed — and a class around it the same way.
endpoint static ScoreOf(key String) -> (score U64):
    observe scores <- NewFeatures.Logic.scores:
        if scores[key]?:
            score = scores[key]

endpoint static ProfileTag(key String) -> (name String, tag U64):
    observe profile <- NewFeatures.Logic.profile:
        name = profile.name
        tag = profile.tags[key]
