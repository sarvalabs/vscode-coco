// Coco 0.9.1 stopped letting maps cross the storage boundary in one move, and
// the check looks through a class's whole field tree.
coco MapDisperse

class Holder:
    field tag String
    field m Map[U64]String

class Plain:
    field tag String

state logic:
    h Holder
    p Plain
    balances Map[U64]String

// EXPECT: maps can't be dispersed into storage
endpoint deploy InitMap():
    mutate c <- MapDisperse.Logic.balances:
        disperse make(Map[U64]String) -> c

// EXPECT: maps can't be dispersed into storage
endpoint deploy InitClass():
    mutate c <- MapDisperse.Logic.h:
        disperse c <- Holder{tag: "a", m: Map[U64]String{}}

// A class with no map anywhere in it still disperses fine.
endpoint deploy InitPlain():
    mutate c <- MapDisperse.Logic.p:
        disperse c <- Plain{tag: "a"}

// A variable resolves through its declared type, so a map-bearing parameter is
// caught the same way a literal is.
// EXPECT: maps can't be dispersed into storage
endpoint dynamic SetHolder(incoming Holder):
    mutate c <- MapDisperse.Logic.h:
        disperse c <- incoming

// The same shape with a map-free class stays silent.
endpoint dynamic SetPlain(incoming Plain):
    mutate c <- MapDisperse.Logic.p:
        disperse c <- incoming
